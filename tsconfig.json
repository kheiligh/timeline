{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// Mirrors the "#lib" imports in package.json. TypeScript doesn't add file extensions when
		// following package imports, so without this the type checker can't find "#lib/..." modules.
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
